# InsightWeave 平台根 .gitignore
# 规则覆盖所有层级的同名路径；模块级 .gitignore 可继续存在，
# 更深层的规则优先于本文件（同一文件的规则后写的优先）。

# ===== Python 虚拟环境 =====
.venv/
.venv-*/
venv/
env/
ENV/

# ===== 前端依赖与构建产物 =====
node_modules/
dist/
.vite/

# ===== Python 与工具缓存 =====
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.hypothesis/

# ===== 构建与安装生成物 =====
*.egg-info/
build/
.eggs/

# ===== 测试覆盖率产物 =====
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json

# ===== 日志 =====
logs/
*.log
*.pid

# ===== 本地二进制样本 =====
*.pkl

# ===== 运行产物目录 =====
# **/output/** 匹配任意位置 output 目录内的文件（不含目录本身），全部按运行产物忽略，不设例外。
# metaweave/output/domains/db_domains.yaml、metaweave/output/dim_config/dim_tables.yaml
# 曾作为例外入库跟踪，现已取消跟踪、只保留在本地（生成方式见 metaweave/AGENTS.md）。
**/output/**

# ===== 含真实凭据的本地配置（安全模板除外）=====
.env
.env.*
!.env.example
!.env.template
.aws/

# ===== 本地代理/助手状态 =====
.remember/
.omo/
.superpowers/
**/.claude/settings.local.json

# ===== 编辑器与操作系统杂项 =====
.vscode/
.idea/
.history/
.DS_Store
Thumbs.db
._*
*.swp
*.swo
*~
*:Zone.Identifier

# 本机部署产物与临时报告（doc 13 §8；实值不入库）
deploy/candidate-*.json
deploy/logs/
# deploy/env/ 下仅入库 *.example 模板（实值 env 文件仍被忽略）
!deploy/env/
deploy/env/*
!deploy/env/*.example
