# Compose 插值模板（doc 13 §7.3 / 13.1 §2）：复制为 deploy.env 填实值；实值不入 Git。
POSTGRES_IMAGE=docker.io/library/postgres:18.1@sha256:1090bc3a8ccfb0b55f78a494d76f8d603434f7e4553543d6e807bc7bd6bbd17f
NEO4J_IMAGE=docker.io/library/neo4j:5.26.19-community@sha256:a75003730d84a6d885ec47fee0cc62d5d59626199d0884286bb535921f68a011
MILVUS_IMAGE=docker.io/milvusdb/milvus:v2.5.2@sha256:7208f04cfd7e5f919d44bb6ae66d163a3a534d44f9437a86bc0162a9fcd8911e
ATTU_IMAGE=docker.io/zilliz/attu:v2.5.10@sha256:709bb38bf5cb5a5be0dbb372c7ad9792bebd6251ff957c31ac7b5d25ce76c5b4
METAWEAVE_IMAGE=insightweave/metaweave:<release_id>
NL2SQL_IMAGE=insightweave/nl2sql:<release_id>
FRONTEND_IMAGE=insightweave/frontend:<release_id>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
NEO4J_PASSWORD=change-me

# 运行环境文件与控制目录（部署目录绝对路径；§5.2/§7.3）
METAWEAVE_ENV_FILE=/absolute/path/config/metaweave.env
NL2SQL_ENV_FILE=/absolute/path/config/nl2sql.env
DEPLOY_CONTROL_DIR=/absolute/path/control

# 本机输入（机器相关，实值由不受 Git 管理的本机配置提供；13.1 §1.1/§5.4）
INSIGHTWEAVE_WSL_PROXY_URL=
INSIGHTWEAVE_BUILD_PROXY_URL=
INSIGHTWEAVE_CI_PYTHON=
