# NL2SQL 的 Docker 覆盖文件模板（doc 16 §2）：复制为 $DEPLOY_ROOT/config/overrides/nl2sql.env 后填实值；实值不入 Git。
# 这里只列由 Docker 部署管理的变量；应用变量（LLM 密钥、日志级别 NL2SQL_LOG_LEVEL 等）来自开发 nl2sql/.env，每次发布由程序合并生成正式 env。
LANGGRAPH_DB_HOST=postgres
LANGGRAPH_DB_PORT=5432
LANGGRAPH_DB_NAME=lg_persist
LANGGRAPH_DB_USER=postgres
LANGGRAPH_DB_PASSWORD=
PLATFORM_DB_HOST=postgres
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=metaweave
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=
NL2SQL_CORS_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
NL2SQL_ALLOWED_HOSTS=localhost,127.0.0.1
# 保留已有数据时必须与平台库已登记数据源的加密凭据匹配；两个后端使用同一密钥
SOURCE_CREDENTIAL_KEY=
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_DATABASE=nl2sql
MILVUS_USER=
MILVUS_PASSWORD=
# 外部业务库连接默认沿用开发 nl2sql/.env 的 DB_*（doc 13 §5.2 连接分界：保持原 Host:Port）；
# 仅当本机 Docker 使用的业务库与开发不同时，在这里只列出确认有差异的字段。
DEPLOY_CONTROL_ENABLED=1
DEPLOY_CONTROL_TOKEN=
