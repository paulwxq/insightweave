DB_HOST=localhost
DB_PORT=5432
DB_NAME=YOUR_DB
DB_USER=YOUR_USER
DB_PASSWORD=YOUR_PASSWORD

# 平台库（与源库 DB_* 分开）
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=metaweave
PLATFORM_DB_USER=YOUR_PLATFORM_USER
PLATFORM_DB_PASSWORD=YOUR_PLATFORM_PASSWORD
# PLATFORM_DB_SSLMODE=require
SOURCE_CREDENTIAL_KEY=YOUR_FERNET_KEY
# 前端页面的 origin，不是后端 API 地址；多个 origin 用逗号分隔
PLATFORM_CORS_ORIGINS=http://127.0.0.1:5173

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_PASSWORD
NEO4J_DATABASE=neo4j

DASHSCOPE_API_KEY=YOUR_KEY
DASHSCOPE_BASE_URI=https://dashscope.aliyuncs.com/compatible-mode/v1

DEEPSEEK_API_KEY=YOUR_KEY
DEEPSEEK_BASE_URI=https://api.deepseek.com/v1

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=nl2sql
